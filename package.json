{
  "name": "space-invaders",
  "version": "1.0.0",
  "description": "Classic Space Invaders for web, Android, and iOS",
  "scripts": {
    "start": "serve . -l tcp://0.0.0.0:${PORT:-3000}",
    "build:icons": "node scripts/generate-icons.js",
    "cap:init": "npx cap init \"Space Invaders\" com.spaceinvaders.game --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android": "npm run cap:sync && npm run cap:open:android",
    "ios": "npm run cap:sync && npm run cap:open:ios"
  },
  "dependencies": {
    "serve": "^14.2.4",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "capacitor": {
    "webDir": "."
  }
}
